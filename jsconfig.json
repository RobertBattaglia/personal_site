{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/utils/*": ["src/utils/*"],
      "@/config/*": ["src/config/*"],
      "@/assets/*": ["src/assets/*"],
      "@/lib/*": ["lib/*"],
      "components/*": ["src/components/*"],
      "utils/*": ["src/utils/*"],
      "config/*": ["src/config/*"],
      "assets/*": ["src/assets/*"]
    }
  },
  "exclude": ["node_modules", ".next", "out", "public"]
}
